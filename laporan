                            <div class="bg-red-50 border border-red-200 rounded-lg p-2 min-w-0 text-right">
                                <div class="text-[10px] font-black text-red-800 uppercase truncate">
                                    ${escapeHTML(m.m)}${winM ? '<i class="fas fa-crown text-amber-500 ml-1"></i>' : ''}
                                </div>
                                <div class="text-[8px] font-bold text-red-500 uppercase truncate">${escapeHTML(m.km)}</div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        };

        window.cetakPDF = function() {
            window.print();
        };

        // Render awal langsung menampilkan seluruh tabel & jumlah folder
        updateFolderBadge();
        renderLaporan();

        // Dengarkan arsip folder dari Firebase agar sinkron antar perangkat
        onValue(folderDbRef, (snapshot) => {
            if (snapshot.exists()) {
                const remoteFolder = snapshot.val() || {};
                Object.keys(remoteFolder).forEach(k => {
                    const remoteItem = remoteFolder[k];
                    const localItem = savedReports[k];
                    if (!localItem || (remoteItem.hasDetail && !localItem.hasDetail) || (Number(remoteItem.updatedAt) || 0) > (Number(localItem.updatedAt) || 0)) {
                        savedReports[k] = remoteItem;
                    }
                });
                saveLocalJSON(LOCAL_ARCHIVE_KEY, savedReports);
                updateFolderBadge();
                if (!document.getElementById('folder-modal').classList.contains('hidden')) {
                    renderFolderList();
                }
                if (selectedArchiveKey) {
                    renderLaporan();
                }
            }
        });

        // Dengarkan state realtime pertandingan dari Firebase
        onValue(dbRef, (snapshot) => {
            if (snapshot.exists()) {
                window.state = snapshot.val();
                processRealtimeArchive(window.state);
                const isLive = typeof window.state.bertandingIdx === 'number' && window.state.bertandingIdx >= 0;
                setConnectionStatus(true, isLive ? 'Online Realtime (Berlangsung)' : 'Online Realtime (Menunggu)');
                if (!selectedArchiveKey) {
                    renderLaporan();
                }
            } else {
                window.state = structuredClone(EMPTY_STATE);
                setConnectionStatus(false, 'Menunggu Pertandingan');
                if (!selectedArchiveKey) {
                    renderLaporan();
                }
            }
        }, (error) => {
            console.error(error);
            setConnectionStatus(false, 'Gagal Terhubung');
            if (!selectedArchiveKey) {
                renderLaporan();
            }
        });
    </script>
</body>
</html>
