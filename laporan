    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getDatabase, ref, onValue, set, remove } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-database.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAHIPab-S8DM2zR7Fd2SDjlELJHRPB8TkA",
            authDomain: "warscoring-60650.firebaseapp.com",
            databaseURL: "https://warscoring-60650-default-rtdb.asia-southeast1.firebasedatabase.app",
            projectId: "warscoring-60650",
            storageBucket: "warscoring-60650.firebasestorage.app",
            messagingSenderId: "782315540387",
            appId: "1:782315540387:web:c0e9f78dfcbb3375719416"
        };
        const app = initializeApp(firebaseConfig);
        const database = getDatabase(app);
        const dbRef = ref(database, 'pencak_scoring_state');
        const folderDbRef = ref(database, 'pencak_laporan_folder');

        const LOCAL_ARCHIVE_KEY = '2cahaya_laporan_folder_v1';
        const LOCAL_CACHE_KEY = '2cahaya_live_match_cache_v1';
        const FOLDER_PAGE_SIZE = 10;

        const EMPTY_STATE = {
            idx: 0,
            bertandingIdx: -1,
            matches: [],
            merah: { juri: { j1: [0,0,0], j2: [0,0,0], j3: [0,0,0] }, penHistory: [], jat: 0, pukulanFreq: 0, tendanganFreq: 0, dis: false, ud: false, wmp: false },
            biru: { juri: { j1: [0,0,0], j2: [0,0,0], j3: [0,0,0] }, penHistory: [], jat: 0, pukulanFreq: 0, tendanganFreq: 0, dis: false, ud: false, wmp: false }
        };

        window.state = structuredClone(EMPTY_STATE);

        // State Folder Arsip, Pagination & Mode Tampilan
        let savedReports = loadLocalJSON(LOCAL_ARCHIVE_KEY, {});
        let liveMatchCache = loadLocalJSON(LOCAL_CACHE_KEY, {});
        let selectedArchiveKey = null; // null = mode live realtime, string = melihat arsip dari folder
        let currentFolderPage = 1;

        function loadLocalJSON(key, fallback) {
            try {
                const raw = localStorage.getItem(key);
                return raw ? JSON.parse(raw) : fallback;
            } catch {
                return fallback;
            }
        }

        function saveLocalJSON(key, val) {
            try {
                localStorage.setItem(key, JSON.stringify(val));
            } catch (e) {
                console.warn('LocalStorage penuh/tidak tersedia:', e);
            }
        }

        function escapeHTML(str) {
            return String(str ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function toArr(val) {
            if (!val) return [];
            if (Array.isArray(val)) return val;
            if (typeof val === 'object') return Object.values(val);
            return [];
        }

        function cloneCorner(c) {
            const src = c || {};
            return {
                juri: {
                    j1: [Number(toArr(src.juri?.j1)[0]) || 0, Number(toArr(src.juri?.j1)[1]) || 0, Number(toArr(src.juri?.j1)[2]) || 0],
                    j2: [Number(toArr(src.juri?.j2)[0]) || 0, Number(toArr(src.juri?.j2)[1]) || 0, Number(toArr(src.juri?.j2)[2]) || 0],
                    j3: [Number(toArr(src.juri?.j3)[0]) || 0, Number(toArr(src.juri?.j3)[1]) || 0, Number(toArr(src.juri?.j3)[2]) || 0]
                },
                penHistory: toArr(src.penHistory).filter(Boolean).map(p => ({ ...p })),
                jat: Number(src.jat) || 0,
                pukulanFreq: Number(src.pukulanFreq) || 0,
                tendanganFreq: Number(src.tendanganFreq) || 0,
                dis: Boolean(src.dis),
                ud: Boolean(src.ud),
                wmp: Boolean(src.wmp)
            };
        }

        function hasCornerActivity(c) {
            if (!c) return false;
            const jSum = ['j1', 'j2', 'j3'].reduce((acc, jk) => acc + toArr(c.juri?.[jk]).reduce((a, b) => a + (Number(b) || 0), 0), 0);
            return jSum !== 0 || (Number(c.jat) || 0) !== 0 || toArr(c.penHistory).length > 0 || (Number(c.pukulanFreq) || 0) !== 0 || (Number(c.tendanganFreq) || 0) !== 0 || c.dis || c.ud || c.wmp;
        }

        function makeSafeKey(str) {
            return String(str || '').trim().toUpperCase().replace(/[.#$\[\]\/\s]+/g, '_').slice(0, 50) || 'EMPTY';
        }

        function buildArchiveKey(mb) {
            return `P${Number(mb?.p) || 0}_${makeSafeKey(mb?.b)}_${makeSafeKey(mb?.m)}`;
        }

        function setConnectionStatus(online, text) {
            const dot = document.getElementById('conn-dot');
            const label = document.getElementById('conn-text');
            if (dot) {
                dot.className = online
                    ? 'inline-block w-2 h-2 rounded-full bg-emerald-500'
                    : 'inline-block w-2 h-2 rounded-full bg-amber-400';
            }
            if (label) {
                label.innerText = text;
            }
        }

        function calculateTotalFromCorner(sc) {
            if (!sc || sc.dis || sc.ud || sc.wmp) return 0;

            const j1 = toArr(sc.juri?.j1);
            const j2 = toArr(sc.juri?.j2);
            const j3 = toArr(sc.juri?.j3);

            const j1T = j1.reduce((a, b) => a + (Number(b) || 0), 0);
            const j2T = j2.reduce((a, b) => a + (Number(b) || 0), 0);
            const j3T = j3.reduce((a, b) => a + (Number(b) || 0), 0);

            const sorted = [j1T, j2T, j3T].sort((a, b) => a - b);
            const tot = sorted[1] || 0;

            const pMap = { teguran1: 1, teguran2: 2, peringatan1: 5, peringatan2: 10 };
            let tp = 0;
            toArr(sc.penHistory).forEach(i => {
                tp += (pMap[i?.type] || 0);
            });

            return tot + (Number(sc.jat) || 0) - tp;
        }

        function getScoreDisplay(sc, numericScore) {
            if (!sc) return numericScore;
            if (sc.dis) return `${numericScore} (DISK)`;
            if (sc.ud) return `${numericScore} (UD)`;
            if (sc.wmp) return `${numericScore} (WMP)`;
            return numericScore;
        }

        // ======================================================
        // LOGIKA SIMPAN OTOMATIS KE FOLDER SAAT TOMBOL FINISH DIKLIK
        // ======================================================
        function processRealtimeArchive(state) {
            if (!state) return;
            const matches = toArr(state.matches);
            const activeIdx = (typeof state.bertandingIdx === 'number' && state.bertandingIdx >= 0)
                ? state.bertandingIdx
                : (Number(state.idx) || 0);

            // 1. Cache skor live untuk partai aktif sebelum berpindah partai
            const activeMatch = matches[activeIdx];
            if (activeMatch && (activeMatch.b || activeMatch.m)) {
                const liveB = cloneCorner(state.biru);
                const liveM = cloneCorner(state.merah);
                if (activeMatch.status !== 'selesai' || hasCornerActivity(liveB) || hasCornerActivity(liveM)) {
                    liveMatchCache[String(activeIdx)] = {
                        p: activeMatch.p,
                        b: activeMatch.b || '',
                        m: activeMatch.m || '',
                        biru: liveB,
                        merah: liveM,
                        updatedAt: Date.now()
                    };
                    saveLocalJSON(LOCAL_CACHE_KEY, liveMatchCache);
                }
            }

            // 2. Deteksi partai yang selesai (tombol FINISH diklik pada Operator atau Dewan)
            let archiveUpdated = false;
            matches.forEach((mb, idx) => {
                if (!mb || mb.status !== 'selesai') return;
                if (!mb.b && !mb.m) return;
                if (mb.b === 'BYE' || mb.m === 'BYE') return;

                const archiveKey = buildArchiveKey(mb);
                const existing = savedReports[archiveKey];

                let detailBiru = null;
                let detailMerah = null;
                let hasDetail = false;

                if (idx === activeIdx && (hasCornerActivity(state.biru) || hasCornerActivity(state.merah) || !existing?.hasDetail)) {
                    detailBiru = cloneCorner(state.biru);
                    detailMerah = cloneCorner(state.merah);
                    hasDetail = hasCornerActivity(detailBiru) || hasCornerActivity(detailMerah);
                } else if (liveMatchCache[String(idx)] && liveMatchCache[String(idx)].b === mb.b && liveMatchCache[String(idx)].m === mb.m) {
                    const cached = liveMatchCache[String(idx)];
                    detailBiru = cloneCorner(cached.biru);
                    detailMerah = cloneCorner(cached.merah);
                    hasDetail = hasCornerActivity(detailBiru) || hasCornerActivity(detailMerah);
                } else if (existing?.hasDetail) {
                    return;
                } else {
                    detailBiru = cloneCorner(null);
                    detailMerah = cloneCorner(null);
                    hasDetail = false;
                }

                if (existing && existing.hasDetail && !hasDetail) return;
                if (existing &&
                    existing.match?.totalB === mb.totalB &&
                    existing.match?.totalM === mb.totalM &&
                    existing.match?.winnerSide === mb.winnerSide &&
                    existing.hasDetail === hasDetail &&
                    JSON.stringify(existing.biru) === JSON.stringify(detailBiru) &&
                    JSON.stringify(existing.merah) === JSON.stringify(detailMerah)) {
                    return;
                }

                const entry = {
                    key: archiveKey,
                    savedAt: existing?.savedAt || Date.now(),
                    updatedAt: Date.now(),
                    hasDetail,
                    match: {
                        p: mb.p || idx + 1,
                        cat: mb.cat || '-',
                        kelas: mb.kelas || '-',
                        gender: mb.gender || '-',
                        fase: mb.fase || '-',
                        b: mb.b || '---',
                        kb: mb.kb || '---',
                        m: mb.m || '---',
                        km: mb.km || '---',
                        status: mb.status || 'selesai',
                        totalB: Number(mb.totalB ?? calculateTotalFromCorner(detailBiru)) || 0,
                        totalM: Number(mb.totalM ?? calculateTotalFromCorner(detailMerah)) || 0,
                        winner: mb.winner || '',
                        winnerSide: mb.winnerSide || ''
                    },
                    biru: detailBiru,
                    merah: detailMerah
                };

                savedReports[archiveKey] = entry;
                archiveUpdated = true;

                set(ref(database, `pencak_laporan_folder/${archiveKey}`), entry).catch(() => {});
            });

            if (archiveUpdated) {
                saveLocalJSON(LOCAL_ARCHIVE_KEY, savedReports);
                updateFolderBadge();
                if (!document.getElementById('folder-modal').classList.contains('hidden')) {
                    renderFolderList();
                }
            }
        }

