        function renderPaginationControls(totalItems, totalPages, startIdx, endIdx) {
            const pagContainer = document.getElementById('folder-pagination');
            const pageInfo = document.getElementById('folder-page-info');
            const pageButtons = document.getElementById('folder-page-buttons');

            if (!pagContainer || !pageInfo || !pageButtons) return;

            if (totalItems === 0) {
                pagContainer.classList.add('hidden');
                pagContainer.classList.remove('flex');
                return;
            }

            pagContainer.classList.remove('hidden');
            pagContainer.classList.add('flex');

            pageInfo.innerText = `No. ${startIdx + 1}–${endIdx} dari ${totalItems} Laporan (Hal ${currentFolderPage}/${totalPages})`;

            let btnsHtml = '';

            // Tombol Sebelumnya
            const prevDisabled = currentFolderPage <= 1;
            btnsHtml += `
                <button type="button" ${prevDisabled ? 'disabled' : `onclick="goToFolderPage(${currentFolderPage - 1})"`}
                    class="px-2 py-1 rounded-lg text-[9px] font-black uppercase border transition ${prevDisabled ? 'bg-slate-200 text-slate-400 border-slate-200 cursor-not-allowed' : 'bg-white hover:bg-slate-200 text-slate-700 border-slate-300 cursor-pointer'}">
                    <i class="fas fa-chevron-left"></i>
                </button>
            `;

            // Hitung rentang tombol halaman yang tampil
            const pages = [];
            for (let p = 1; p <= totalPages; p++) {
                if (p === 1 || p === totalPages || (p >= currentFolderPage - 1 && p <= currentFolderPage + 1)) {
                    pages.push(p);
                } else if (pages[pages.length - 1] !== '...') {
                    pages.push('...');
                }
            }

            pages.forEach(p => {
                if (p === '...') {
                    btnsHtml += `<span class="px-1 text-[10px] font-bold text-slate-400">...</span>`;
                } else if (p === currentFolderPage) {
                    btnsHtml += `
                        <button type="button" class="min-w-[26px] h-[26px] px-1.5 rounded-lg text-[10px] font-black bg-teal-600 text-white border border-teal-600 shadow-sm">
                            ${p}
                        </button>
                    `;
                } else {
                    btnsHtml += `
                        <button type="button" onclick="goToFolderPage(${p})" class="min-w-[26px] h-[26px] px-1.5 rounded-lg text-[10px] font-black bg-white hover:bg-teal-50 text-slate-700 border border-slate-300 cursor-pointer transition">
                            ${p}
                        </button>
                    `;
                }
            });

            // Tombol Berikutnya
            const nextDisabled = currentFolderPage >= totalPages;
            btnsHtml += `
                <button type="button" ${nextDisabled ? 'disabled' : `onclick="goToFolderPage(${currentFolderPage + 1})"`}
                    class="px-2 py-1 rounded-lg text-[9px] font-black uppercase border transition ${nextDisabled ? 'bg-slate-200 text-slate-400 border-slate-200 cursor-not-allowed' : 'bg-white hover:bg-slate-200 text-slate-700 border-slate-300 cursor-pointer'}">
                    <i class="fas fa-chevron-right"></i>
                </button>
            `;

            pageButtons.innerHTML = btnsHtml;
        }

