        window.openFolderModal = function() {
            const modal = document.getElementById('folder-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            renderFolderList();
        };

        window.closeFolderModal = function() {
            const modal = document.getElementById('folder-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        };

        window.onSearchFolder = function() {
            currentFolderPage = 1;
            renderFolderList();
        };

        window.goToFolderPage = function(page) {
            currentFolderPage = Math.max(1, Number(page) || 1);
            renderFolderList();
            const body = document.getElementById('folder-list-body');
            if (body) body.scrollTop = 0;
        };

        window.loadArchivedReport = function(key) {
            if (!savedReports[key]) return;
            selectedArchiveKey = key;
            closeFolderModal();
            renderLaporan();
        };

        window.cetakArchivedPDF = function(key, e) {
            if (e) e.stopPropagation();
            if (!savedReports[key]) return;
            selectedArchiveKey = key;
            closeFolderModal();
            renderLaporan();
            setTimeout(() => {
                window.print();
            }, 150);
        };

        window.switchToLiveMode = function() {
            selectedArchiveKey = null;
            renderLaporan();
        };

        window.deleteArchivedReport = function(key, e) {
            if (e) e.stopPropagation();
            if (!confirm('Hapus arsip laporan partai ini dari folder?')) return;
            delete savedReports[key];
            saveLocalJSON(LOCAL_ARCHIVE_KEY, savedReports);
            remove(ref(database, `pencak_laporan_folder/${key}`)).catch(() => {});
            if (selectedArchiveKey === key) {
                selectedArchiveKey = null;
                renderLaporan();
            }
            updateFolderBadge();
            renderFolderList();
        };

        window.clearAllFolder = function() {
            if (Object.keys(savedReports).length === 0) return;
            if (!confirm('Kosongkan seluruh arsip laporan di dalam folder?')) return;
            savedReports = {};
            saveLocalJSON(LOCAL_ARCHIVE_KEY, savedReports);
            remove(folderDbRef).catch(() => {});
            selectedArchiveKey = null;
            currentFolderPage = 1;
            updateFolderBadge();
            renderFolderList();
            renderLaporan();
